# ==========================================
# PatunAI (AegisExam) - Vercel Environment Variables
# ==========================================

# ------------------------------------------
# Database (PostgreSQL - Supabase / Neon / Vercel Postgres)
# ------------------------------------------
# Pooled connection string (for queries)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct connection string (for migrations/Prisma CLI)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ------------------------------------------
# NextAuth.js / Auth.js (v5)
# ------------------------------------------
# Secret key for encrypting session tokens (generate with `openssl rand -base64 32` or `npx auth secret`)
AUTH_SECRET="your-generated-auth-secret-key-at-least-32-chars"

# Canonical URL of your deployment (Vercel production domain)
AUTH_URL="https://your-app.vercel.app"
NEXTAUTH_URL="https://your-app.vercel.app"

# ------------------------------------------
# Google OAuth & Classroom API Credentials
# Configure in Google Cloud Console with authorized redirect URI:
# https://your-app.vercel.app/api/auth/callback/google
# ------------------------------------------
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Optional: Default email automatically granted the TEACHER role
DEFAULT_TEACHER_EMAIL="teacher@example.com"

# ------------------------------------------
# Google Gemini AI API
# ------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"

# Optional Model Overrides (defaults to stable Gemini 2.5/3.x models)
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_EXAM_MODEL="gemini-3.6-flash"
GEMINI_PARSER_MODEL="gemini-3.5-flash-lite"
GEMINI_PARSER_FALLBACK="gemini-3.1-flash-lite"
